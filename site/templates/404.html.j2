<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Not found - Chronoscape</title>
<meta name="robots" content="noindex">
{# A 404 can be served at any depth, so relative prefixes are useless here.
   {{ root }} is the deployment base path - "/" at a domain root,
   "/chronoscape/" when served under the hub domain. #}
<link rel="icon" href="{{ root }}static/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ root }}static/favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="{{ root }}static/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}static/style.css?v={{ version }}">
<!-- Cloudflare Web Analytics. Manual, not edge-injected: the account's Web
     Analytics site is in "JS Snippet installation" mode so that the non-proxied
     hosts (GitHub Pages, Vercel) are counted too, and in that mode Cloudflare
     stops injecting automatically here. Without this tag Chronoscape reports
     nothing. -->
<script>/* Analytics, gated. Two kinds of visitor are not an audience: anyone who has opted out with ?nostats=1, and automation - navigator.webdriver is the one signal true for Playwright, Puppeteer and Selenium alike. Inline and dependency-free on purpose: served from the Worker, a bad deploy there would stop analytics on every site. See site-stats/beacon. */
(function(){try{var X="ct.nostats",C="ct_nostats",D=";path=/;domain=.charlietrenorden.com",q=location.search,out=false;if(q.indexOf("nostats=1")>-1){try{localStorage.setItem(X,"1")}catch(e){}document.cookie=C+"=1"+D+";max-age=63072000;samesite=lax";}if(q.indexOf("nostats=0")>-1){try{localStorage.removeItem(X)}catch(e){}document.cookie=C+"="+D+";max-age=0";}try{out=!!localStorage.getItem(X)}catch(e){}if(!out)out=document.cookie.indexOf(C+"=1")>-1;if(out||navigator.webdriver)return;var d=document,s;s=d.createElement("script");s.defer=true;s.src="https://static.cloudflareinsights.com/beacon.min.js";s.setAttribute("data-cf-beacon",'\x7b"token": "32b821209b5441a08df42ccf61c9e6c2"\x7d');d.head.appendChild(s);s=d.createElement("script");s.defer=true;s.src="https://beacon.charlietrenorden.com/b.js";d.head.appendChild(s);}catch(e){}})();</script>
</head>
<body>

<header class="site-header">
  <div>
    <h1><a href="{{ root }}" style="color:inherit;text-decoration:none">Chronoscape</a></h1>
    <p class="tagline">Interactive timelines of world history</p>
  </div>
</header>

<div class="welcome">
  <div class="welcome-icon">&#128269;</div>
  <h2>That page doesn't exist</h2>
  <p>The timeline you're after may have moved, or may not be here yet. Pick one below.</p>
</div>

<nav class="country-picker" aria-label="Select country">
  <span class="picker-label">Available timelines</span>
  <ul class="chips">
    {% for c in all_countries %}
    <li><a class="chip" href="{{ root }}{{ c.slug }}/">{{ c.name }}</a></li>
    {% endfor %}
  </ul>
</nav>

<footer class="site-footer">{{ version }}</footer>
</body>
</html>

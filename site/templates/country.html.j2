<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set page_desc = "An interactive timeline of " ~ country.name ~ "'s history - " ~ events|length ~ " events across " ~ eras|length ~ " eras, " ~ date_range ~ "." %}
<title>{{ country.name }} - Chronoscape</title>
<meta name="description" content="{{ page_desc }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Chronoscape">
<meta property="og:title" content="{{ country.name }} - Chronoscape">
<meta property="og:description" content="{{ page_desc }}">
<meta property="og:url" content="{{ canonical }}">
{# One card for the whole site rather than one per country: it is a committed
   PNG (tools/make_og_image.py), not a build artefact, so per-country variants
   would mean seven files to regenerate every time the wordmark moves. #}
<meta property="og:image" content="{{ site_url }}/static/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Chronoscape - interactive timelines of world history">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ country.name }} - Chronoscape">
<meta name="twitter:description" content="{{ page_desc }}">
<meta name="twitter:image" content="{{ site_url }}/static/og.png">
{# {{ base }} like every other asset here. These three were the last root-absolute
   refs in the file, which was harmless while the site sat at a domain root and breaks
   the moment it is served from a subpath. #}
<link rel="icon" href="{{ base }}static/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ base }}static/favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="{{ base }}static/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@600&display=swap" rel="stylesheet">
<link href="https://unpkg.com/maplibre-gl@6.1.0/dist/maplibre-gl.css" rel="stylesheet">
<link rel="stylesheet" href="{{ base }}static/style.css?v={{ version }}">
<!-- Cloudflare Web Analytics. Manual, not edge-injected: the account's Web
     Analytics site is in "JS Snippet installation" mode so that the non-proxied
     hosts (GitHub Pages, Vercel) are counted too, and in that mode Cloudflare
     stops injecting automatically here. Without this tag Chronoscape reports
     nothing. -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "32b821209b5441a08df42ccf61c9e6c2"}'></script><script defer src="https://beacon.charlietrenorden.com/b.js"></script>
</head>
<body>

<header class="site-header">
  {# The wordmark and the back-link are SIBLINGS here, not a block and a link. Wrapped
     in a div with the tagline, the block's width was set by the tagline - 233px of
     "Interactive timelines of world history" against 358px of usable header - so no
     size of wordmark ever left room for the link and it wrapped to its own row. The
     tagline takes the full width underneath instead, which is also the arrangement
     every other project page uses: mark left, link right, on one line. #}
  <h1>Chronoscape</h1>
  {# Same tab, deliberately. The arrow changed with it: the up-right arrow is the
     convention for "opens in a new window", so keeping it after dropping
     target="_blank" would have left the icon lying. A back arrow also matches the
     "<- Other projects" pattern the rest of the estate already uses. #}
  <a class="hub-link" href="https://charlietrenorden.com/"><span aria-hidden="true">&#8592;</span>&nbsp;Other projects</a>
  <p class="tagline">Interactive timelines of world history</p>
</header>

<nav class="country-picker" aria-label="Select country">
  <span class="picker-label">Select country</span>
  <ul class="chips">
    {% for c in all_countries %}
    <li><a class="chip{% if c.slug == slug %} chip-active{% endif %}" href="{{ base }}{{ c.slug }}/"{% if c.slug == slug %} aria-current="page"{% endif %}>{{ c.name }}</a></li>
    {% endfor %}
  </ul>
  {# Thirteen chips take four rows on a phone, about 110px, above a map that was
     already starting below the fold. The same list as a select is one row. Both are
     rendered and CSS picks: the chips are plain links and work with no JavaScript,
     which is the behaviour worth keeping wherever there is room for them. #}
  <select class="country-select" id="country-select" aria-label="Select country">
    {% for c in all_countries %}
    <option value="{{ base }}{{ c.slug }}/"{% if c.slug == slug %} selected{% endif %}>{{ c.name }}</option>
    {% endfor %}
  </select>
</nav>

<p class="subtitle">{{ country.name }} &nbsp;|&nbsp; {{ date_range }} &nbsp;|&nbsp; <span id="event-count">{{ events|length }}</span> events</p>

<div class="filters">
  <input type="search" id="search" placeholder="Search by keyword..." aria-label="Search events">
  <select id="era-filter" aria-label="Filter by era">
    <option value="">All eras</option>
    {% for e in eras %}
    <option value="{{ e.name }}">{{ e.name }}</option>
    {% endfor %}
  </select>
  <select id="cat-filter" aria-label="Filter by category">
    <option value="">All categories</option>
    {% for c in categories %}
    <option value="{{ c }}">{{ c }}</option>
    {% endfor %}
  </select>
  <label class="toggle"><input type="checkbox" id="key-only"> Key events</label>
</div>

<p class="visually-hidden" id="tl-help">
  Timeline of {{ events|length }} events across {{ eras|length }} eras. Use the left and right
  arrow keys to move between events, Home and End to jump to the first or last, and Enter to
  select. Every event is also listed in full below.
</p>
<div id="timeline-wrapper" class="tl-wrapper">
  <div class="tl-fade-left"></div>
  <div class="tl-fade-right"></div>
  <div class="tl-container" id="tl-container" tabindex="0" role="listbox"
       aria-label="Event timeline for {{ country.name }}" aria-describedby="tl-help">
    <div class="tl-ribbon" id="tl-ribbon"></div>
  </div>
</div>
<div class="tl-tooltip" id="tl-tooltip" role="tooltip"></div>

<ul class="legend">
  {% for e in eras %}
  <li><span class="swatch" style="background:{{ e.color }}"></span>{{ e.short_name }}</li>
  {% endfor %}
  <li><span class="swatch swatch-key"></span>Key event</li>
</ul>

<main class="layout">
  <div id="map" aria-label="Map of events"></div>

  <section class="list-pane" aria-label="Event list">
    <ol class="event-list" id="event-list">
      {# Rendered server-side on purpose: this is real HTML in the source, so it
         is indexable and readable without JavaScript. Streamlit cannot do this. #}
      {% for ev in events %}
      <li class="event-item" data-id="{{ ev.id }}" data-era="{{ ev.era_name }}" data-major="{{ '1' if ev.is_major else '0' }}" data-cats="{{ (ev.categories or [])|join('|') }}">
        <button class="event-card" style="border-left-color:{{ ev.era_color }}" data-id="{{ ev.id }}">
          <span class="event-date">{% if ev.is_major %}&#9733; {% endif %}{{ ev.display_date }}</span>
          <span class="event-title">{{ ev.title }}</span>
        </button>
      </li>
      {% endfor %}
    </ol>
  </section>

  <aside class="detail-pane" id="detail" aria-live="polite">
    <div class="detail-empty" id="detail-empty">
      <div class="detail-icon">&#127963;</div>
      <h2>Select an event</h2>
      <p>Click an event in the list, a dot on the timeline, or a marker on the map.</p>
    </div>
    <article class="detail-panel" id="detail-body" hidden>
      <p class="detail-date" id="detail-date"></p>
      <h2 id="detail-title"></h2>
      <div class="tags-row" id="detail-tags"></div>
      <p class="detail-body-text" id="detail-desc"></p>
      <a class="detail-source" id="detail-source" href="#" target="_blank" rel="noopener" hidden>Wikipedia &#8599;</a>
      <button class="clear-btn" id="clear-selection">Clear selection</button>
    </article>
  </aside>
</main>

<noscript>
  <p class="noscript-note">The timeline and map need JavaScript, but the full list of {{ events|length }} events is above and fully readable without it.</p>
</noscript>

<footer class="site-footer">{{ version }}</footer>

{# Prefetch a country page when the pointer lands on its chip, so the click is
   already served from cache. `moderate` is hover-triggered, not eager, so idle
   visitors never pull the other six pages (~120KB each). Chromium only;
   ignored elsewhere. #}
<script type="speculationrules">
{"prefetch": [{"where": {"selector_matches": ".chip"}, "eagerness": "moderate"}]}
</script>

<script id="payload" type="application/json">{{ payload }}</script>
{# MapLibre v6 ships ESM only (no UMD build), so app.js is a module and imports
   it directly from the CDN. Native browser ESM - still no build step. #}
<script type="module" src="{{ base }}static/app.js?v={{ version }}"></script>
</body>
</html>
